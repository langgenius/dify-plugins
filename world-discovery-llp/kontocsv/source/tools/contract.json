[
  {
    "name": "create_browser_upload_session",
    "description": "Creates a short-lived KontoCSV browser upload link for a PDF bank, card or payment statement, or a transaction CSV. The user selects and uploads the file on KontoCSV's website. Creating the link does not start a conversion or spend credits.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "default": "statement.pdf"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "application/pdf",
            "text/csv"
          ]
        },
        "locale": {
          "type": "string",
          "enum": [
            "de",
            "en",
            "fr",
            "es",
            "it",
            "nl"
          ],
          "default": "en"
        }
      },
      "required": [
        "mediaType"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "uploadSessionId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "browserUploadUrl": {
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "maxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "uploadSessionId",
        "browserUploadUrl",
        "expiresAt",
        "maxBytes"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "title": "Create browser upload",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "complete_browser_upload",
    "description": "Checks whether a previously created KontoCSV browser upload has completed and returns a user-bound source reference based on the uploaded object's stored metadata. This does not start a conversion or spend credits.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "uploadSessionId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "required": [
        "uploadSessionId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "application/pdf",
            "text/csv"
          ]
        },
        "fileSizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1992294400
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sourceId",
        "filename",
        "mediaType",
        "fileSizeBytes",
        "expiresAt"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "title": "Complete browser upload",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "inspect_bank_statement",
    "description": "Inspects an uploaded bank, card or payment statement and returns document scope, account structure, currency, balance evidence and compatible accounting export profiles. Inspection does not spend credits or start a paid conversion.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "locale": {
          "type": "string",
          "enum": [
            "de",
            "en",
            "fr",
            "es",
            "it",
            "nl"
          ],
          "default": "de"
        }
      },
      "required": [
        "sourceId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "documentKind": {
          "type": "string",
          "enum": [
            "bank_statement",
            "credit_card_statement",
            "payment_statement",
            "csv_transactions",
            "unsupported"
          ]
        },
        "pageCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "transactionCountEstimate": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "accountCountEstimate": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "openingBalanceDetected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "closingBalanceDetected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "strictBalanceFormatsPotentiallyAvailable": {
          "type": "boolean"
        },
        "supportedExportProfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "standard_bank",
              "datev_skr03",
              "datev_skr04",
              "lexware",
              "mt940",
              "camt053_v8",
              "quickbooks_qbo",
              "quickbooks_online_csv",
              "xero_csv",
              "wave_csv",
              "zoho_books_csv",
              "exact_online",
              "twinfield",
              "yuki",
              "e_boekhouden",
              "holded",
              "a3_bank",
              "pennylane_fr",
              "sage50_ciel_fr",
              "cegid_loop_fr",
              "fatture_in_cloud",
              "teamsystem_contabilita_in_cloud",
              "zucchetti_ago_infinity",
              "passepartout_passcom_mexal"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sourceId",
        "documentKind",
        "pageCount",
        "transactionCountEstimate",
        "accountCountEstimate",
        "currency",
        "openingBalanceDetected",
        "closingBalanceDetected",
        "strictBalanceFormatsPotentiallyAvailable",
        "supportedExportProfiles",
        "warnings"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "title": "Inspect bank statement",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
