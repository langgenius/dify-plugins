  {
    "name": "get_credit_balance",
    "description": "Returns the authenticated KontoCSV account's current total, reserved and available conversion-credit balance.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "enum": [
            "de",
            "en",
            "fr",
            "es",
            "it",
            "nl"
          ],
          "default": "de"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "totalCredits": {
          "type": "integer",
          "minimum": 0
        },
        "reservedCredits": {
          "type": "integer",
          "minimum": 0
        },
        "availableCredits": {
          "type": "integer",
          "minimum": 0
        },
        "nextExpiry": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "totalCredits",
        "reservedCredits",
        "availableCredits",
        "nextExpiry"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "title": "Get credit balance",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "convert_bank_statement_for_accounting",
    "description": "Starts a previously prepared KontoCSV conversion after explicit user confirmation. KontoCSV reserves service credits atomically before processing and captures them according to the existing job-outcome policy.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "quoteId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "confirmedByUser": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "quoteId",
        "confirmedByUser"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "queued"
            },
            "jobId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "creditsReserved": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "status",
            "jobId",
            "creditsReserved"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "payment_required"
            },
            "quoteId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 4096,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "requiredCredits": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "availableCredits": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "status",
            "quoteId",
            "requiredCredits",
            "availableCredits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "reauthentication_required"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "title": "Convert statement for accounting",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_conversion_status",
    "description": "Returns the current processing, quality and export-readiness status of an already-started KontoCSV conversion job. It does not start a new conversion or charge additional credits.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "required": [
        "jobId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "processing",
            "completed",
            "soft_fail",
            "hard_fail",
            "cancelled"
          ]
        },
        "progressPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "exportReady": {
          "type": "boolean"
        },
        "qualityStatus": {
          "type": "string",
          "enum": [
            "validated",
            "review_required",
            "failed",
            "pending"
          ],
          "default": "pending"
        }
      },
      "required": [
        "jobId",
        "status",
        "progressPercent",
        "message",
        "exportReady"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "title": "Get conversion status",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "download_accounting_export",
    "description": "Returns a short-lived download URL for a completed KontoCSV accounting export belonging to the authenticated user. A URL is returned only when the job outcome permits a downloadable file.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "required": [
        "jobId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "qualityStatus": {
          "type": "string",
          "enum": [
            "validated",
            "review_required"
          ]
        }
      },
      "required": [
        "jobId",
        "filename",
        "mediaType",
        "downloadUrl",
        "expiresAt",
        "qualityStatus"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "title": "Download accounting export",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
